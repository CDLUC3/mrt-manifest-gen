<html>
<head>
  <title>Manifest Generator</title>
  <link rel="stylesheet" href="/wkspace.css">
  <link rel="icon" href="/favicon.ico" />
</head>
<body>
<h1>Manifest Generator for <%= iconfig.project %></h1>
<form method="get" action="/<%= iconfig.path %>">
  <input type="hidden" name="reload" value="true">
  <input type="submit" value="Reload Inventory">
</form>
<dl>
  <dt>Source Bucket</dt>
  <dd>"<%= iconfig.source %>"</dd>
  <dt>Prefix</dt>
  <dd>"<%= iconfig.prefix %>"</dd>
  <dt>Path</dt>
  <dd>"<%= iconfig.path %>"</dd>
  <dt>Mode</dt>
  <dd><%= iconfig.mode %></dd>
  <dt>Last Updated</dt>
  <dd><%= Time.at(iconfig.inventory.last_updated).localtime.strftime("%Y-%m-%d %H:%M:%S") %></dd>
  <dt>Reload Param</dt>
  <dd><%= iconfig.reload ? 'Yes' : 'No' %></dd>
  <dt>Reload Needed</dt>
  <dd><%= iconfig.reload_needed ? 'Yes' : 'No' %></dd>
  <dt>Cache Bucket</dt>
  <dd><%= iconfig.cache_bucket %></dd>
</dl>

<h3>Prefixes</h3>
<table>
  <thead>
  <tr>
    <th>Prefix</th>
    <th>Depth</th>
    <th>Count</th>
    <th>Bytes</th>
    <th>Actions</th>
  </tr>
  </thead>
  <tbody>
    <% unless iconfig.path.empty? %>
    <tr>
      <td><a href="<%= iconfig.top_path %>"><%= iconfig.top_name %></a></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_depth('')) %></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_count('')) %></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_bytes('')) %></td>
      <td/>
    </tr>
    <% end %>
    <% unless iconfig.parent_path.empty? %>
    <tr>
      <td><a href="/<%= iconfig.parent_path %>"><%= iconfig.parent_name %></a></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_depth(iconfig.parent_path)) %></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_count(iconfig.parent_path)) %></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_bytes(iconfig.parent_path)) %></td>
      <td/>
    </tr>
    <% end %>
    <tr>
      <td class="current"><span><%= iconfig.path %></span></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_depth(iconfig.path)) %></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_count(iconfig.path)) %></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_bytes(iconfig.path)) %></td>
      <td>
        <form method="POST" action="/manifest">
          <input type="hidden" name="path" value="<%= iconfig.path %>">
          <label for="preview">Preview:</label>
          <input type="checkbox" name="preview" checked value="true" id="preview">
          <label for="depth">Manifest Depth:</label>
          <select name="depth">
            <option value="">Object Manifest</option>
            <% if iconfig.inventory.path_depth(iconfig.path) > 0 %>
              <option value="1">Depth 1</option>
            <% end %>
            <% for i in 2..iconfig.inventory.path_depth(iconfig.path) %>
              <option value="<%= i %>">Depth <%= i %></option>
              <option value="<%= -(i-1) %>">Depth <%= -(i-1) %></option>
            <% end %>
          </select>
          <input type="submit" value="Make Manifest">
        </form>
      </td>
    </tr>
    <% iconfig.inventory.prefixes(iconfig.path).each do |prefix| %>
    <tr>
      <td><a href="<%= iconfig.prefix_path(prefix) %>"><%= prefix %></a></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_depth(prefix)) %></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_count(prefix)) %></td>
      <td class="data"><%= Inventory.format_int(iconfig.inventory.path_bytes(prefix)) %></td>
      <td/>
    </tr>
    <% end %>
  </tbody>
</table>

<h3>Files</h3>
<table>
  <thead>
  <tr>
    <th>Key</th>
    <th>Size</th>
    <th>Last Modified</th>
  </tr>
  </thead>
  <tbody>
  <% iconfig.inventory.files(iconfig.path).each do |file| %>
  <tr>
    <td><%= file[:key] %></td>
    <td class="data"><%= Inventory.format_int(file[:size]) %></td>
    <td><%= file[:last_modified] %></td>
  </tr>
  <% end %>
  </tbody>
</table>

<h3>Summary Stats</h3>
<table>
  <tr>
    <th>Extension</th>
    <th>Count</th>
    <th>Bytes</th>
  </tr>
  <% iconfig.inventory.extensions(iconfig.path).each do |ext, info| %>
  <tr>
    <td><%= ext %></td>
    <td class="data"><%= Inventory.format_int(info[:count]) %></td>
    <td class="data"><%= Inventory.format_int(info[:bytes]) %></td>
  </tr>
  <% end %>
</table>
</body>
</html>