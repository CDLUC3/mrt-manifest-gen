<html>
<head>
  <title>Manifest Generator</title>
  <link rel="stylesheet" href="/wkspace.css">
  <link rel="icon" href="/favicon.ico" />
</head>
<body>
<h1>Manifest Generator for <%= iconfig.project %></h1>
<form method="get" action="/<%= iconfig.path %>">
  <input type="hidden" name="reload" value="true">
  <input type="submit" value="Reload Inventory">
</form>
<dl>
  <dt>Source Bucket</dt>
  <dd>"<%= iconfig.source %>"</dd>
  <dt>Prefix</dt>
  <dd>"<%= iconfig.prefix %>"</dd>
  <dt>Path</dt>
  <dd>"<%= iconfig.path %>"</dd>
  <dt>Mode</dt>
  <dd><%= iconfig.mode %></dd>
  <dt>Last Updated</dt>
  <dd><%= Time.at(iconfig.inventory.last_updated).localtime.strftime("%Y-%m-%d %H:%M:%S") %></dd>
  <dt>Reload Param</dt>
  <dd><%= iconfig.reload ? 'Yes' : 'No' %></dd>
  <dt>Reload Needed</dt>
  <dd><%= iconfig.reload_needed ? 'Yes' : 'No' %></dd>
  <dt>Cache Bucket</dt>
  <dd><%= iconfig.cache_bucket %></dd>
</dl>
<h3>Stats</h3>
<ul>
  <li>Bucket Count: <%= Inventory.format_int(iconfig.inventory.count) %></li>
  <li>Bucket Bytes: <%= Inventory.format_int(iconfig.inventory.bytes) %></li>
  <li>Path Count: <%= Inventory.format_int(iconfig.inventory.path_count(iconfig.path)) %></li>
  <li>Path Bytes: <%= Inventory.format_int(iconfig.inventory.path_bytes(iconfig.path)) %></li>
</ul>
<h3>Prefixes</h3>
<ul>
  <li><a href="<%= iconfig.top_path %>"><%= iconfig.top_name %></a></li>
  <%unless iconfig.path.empty? %>
  <li><a href="<%= iconfig.parent_path %>"><%= iconfig.parent_name %></a></li>
  <% end %>
  <% iconfig.inventory.prefixes(iconfig.path).each do |prefix| %>
    <li><a href="<%= iconfig.prefix_path(prefix) %>"><%= prefix %></a></li>
  <% end %>
</ul>

<h3>Files</h3>
<table>
  <tr>
    <th>Key</th>
    <th>Size</th>
    <th>Last Modified</th>
  </tr>
  <% iconfig.inventory.files(iconfig.path).each do |file| %>
  <tr>
    <td><%= file[:key] %></td>
    <td class="data"><%= Inventory.format_int(file[:size]) %></td>
    <td><%= file[:last_modified] %></td>
  </tr>
  <% end %>
</table>

<h3>Summary Stats</h3>
<table>
  <tr>
    <th>Extension</th>
    <th>Count</th>
    <th>Bytes</th>
  </tr>
  <% iconfig.inventory.extensions(iconfig.path).each do |ext, info| %>
  <tr>
    <td><%= ext %></td>
    <td class="data"><%= Inventory.format_int(info[:count]) %></td>
    <td class="data"><%= Inventory.format_int(info[:bytes]) %></td>
  </tr>
  <% end %>
</table>
</body>
</html>